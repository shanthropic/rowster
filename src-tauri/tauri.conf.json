{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rowster",
  "version": "0.1.0",
  "identifier": "dev.rowster.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rowster",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Browser",
    "shortDescription": "A privacy-respecting, multi-tab desktop browser",
    "longDescription": "Rowster is a privacy-respecting, multi-tab desktop web browser built with Rust and Tauri. Each tab is a real native webview isolated from the trusted chrome.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
